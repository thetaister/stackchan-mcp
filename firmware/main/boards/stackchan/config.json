                "CONFIG_MICRO_WAKE_WORD_DISPLAY=\"hey mochi\"",
                "CONFIG_MICRO_WAKE_WORD_CUTOFF=97",
                "CONFIG_MICRO_WAKE_WORD_WINDOW=5",
                "CONFIG_MICRO_WAKE_WORD_ARENA_SIZE=26080",
                "CONFIG_SR_MN_CN_NONE=y",
                "CONFIG_SR_MN_EN_NONE=y"
